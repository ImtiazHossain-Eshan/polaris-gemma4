# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- Dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js ----
/.next/
/out/
/build
next-env.d.ts

# ---- Testing / coverage ----
/coverage

# ---- TypeScript ----
*.tsbuildinfo

# ---- Environment variables ----
.env
.env.*
!.env.example
!.env.local.example

# ---- Vercel ----
.vercel

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Editor / tooling ----
.vscode/
.idea/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Certificates ----
*.pem

# ---- Local recordings / large media ----
*.mkv
*.mp4
# ---- Local tooling / generated judge artifacts ----
/.cache/
/.turbo/
/.history/
/playwright-report/
/test-results/
/artifacts/
/tmp/
/scripts/
/.local-logs/
*.webm
*.mov
*.zip
*.bak
*.tmp
# ---- Local submission workflow notes ----
SUBMISSION_CHECKLIST.md
KAGGLE_FORM.md
KAGGLE_DESCRIPTION.md
PITCH.md
DEMO_SCRIPT.md
